# winnipegelection.ca redirects to the canonical www host.
server {
    listen 80;
    server_name winnipegelection.ca;

    return 301 https://www.winnipegelection.ca$request_uri;
}

server {
    listen 443 ssl;
    server_name winnipegelection.ca;

    ssl_certificate /etc/letsencrypt/live/winnipegelection.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/winnipegelection.ca/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://www.winnipegelection.ca$request_uri;
}

# HTTP requests for configured subdomains keep their hostname and move to HTTPS.
server {
    listen 80;
    server_name
        www.winnipegelection.ca
        2022.winnipegelection.ca
        2018.winnipegelection.ca
        2014.winnipegelection.ca
        dev.winnipegelection.ca;

    return 301 https://$host$request_uri;
}

# Current www site. For now this continues to serve the 2022 WordPress site.
server {
    listen 443 ssl;
    server_name www.winnipegelection.ca;

    root /var/www/winnipegelection.ca/2022.winnipegelection.ca;
    index index.php;

    ssl_certificate /etc/letsencrypt/live/www.winnipegelection.ca/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.winnipegelection.ca/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    error_log /var/www/winnipegelection.ca/logs/www.error.log error;

    fastcgi_buffers 16 16k;
    fastcgi_buffer_size 32k;

    location = /robots.txt {
        try_files $uri $uri/ /index.php?$args;
        log_not_found off;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.php?q=$uri&$args;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.1-fpm.sock;
        fastcgi_read_timeout 240;
    }

    # Increase timeout for the initial news scrape.
    proxy_read_timeout 240;
    proxy_connect_timeout 240;
    proxy_send_timeout 240;
}

